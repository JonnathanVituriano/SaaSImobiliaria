# ============================================
# SaaS Imobiliária - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env no Git!
# ============================================

# ---- Banco de Dados ----
DB_USER=saas_user
DB_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
DB_NAME=saas_imobiliaria
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://saas_user:TROQUE_POR_UMA_SENHA_FORTE@localhost:5432/saas_imobiliaria?schema=public

# ---- JWT ----
JWT_SECRET=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- Aplicação ----
APP_PORT=3001
APP_ENV=development
# development | staging | production

# ---- WhatsApp Cloud API (configurar depois) ----
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# ---- Gateway de Pagamento (configurar depois) ----
# PAYMENT_GATEWAY=asaas
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_GATEWAY_WEBHOOK_SECRET=

# ---- Super Admin (primeiro acesso) ----
SUPER_ADMIN_EMAIL=admin@saasimobiliaria.com
SUPER_ADMIN_PASSWORD=TROQUE_ESSA_SENHA

