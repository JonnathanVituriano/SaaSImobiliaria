// ============================================
// SaaS Imobiliária - Prisma Schema
// ============================================
// Este arquivo define TODAS as tabelas do banco.
// Após editar, rode: npx prisma migrate dev
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ORGANIZAÇÕES (Imobiliárias)
// ============================================

model Organization {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @db.VarChar(255)
  cnpj                String   @unique @db.VarChar(18)
  email               String   @db.VarChar(255)
  phone               String?  @db.VarChar(20)
  addressStreet       String?  @map("address_street") @db.VarChar(255)
  addressNumber       String?  @map("address_number") @db.VarChar(20)
  addressComplement   String?  @map("address_complement") @db.VarChar(100)
  addressNeighborhood String?  @map("address_neighborhood") @db.VarChar(100)
  addressCity         String?  @map("address_city") @db.VarChar(100)
  addressState        String?  @map("address_state") @db.Char(2)
  addressZip          String?  @map("address_zip") @db.VarChar(10)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relações
  settings            OrganizationSettings?
  users               User[]
  roles               Role[]
  owners              Owner[]
  properties          Property[]
  tenants             Tenant[]
  contracts           Contract[]
  billings            Billing[]
  payments            Payment[]
  collectionTemplates CollectionTemplate[]
  collectionMessages  CollectionMessage[]
  auditLogs           AuditLog[]

  @@map("organizations")
}

// ============================================
// CONFIGURAÇÕES DA ORGANIZAÇÃO
// ============================================

model OrganizationSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @unique @map("organization_id") @db.Uuid
  
  // Multa e Juros
  penaltyPercentage         Decimal  @default(2.00) @map("penalty_percentage") @db.Decimal(5, 2)
  interestPercentage        Decimal  @default(1.00) @map("interest_percentage") @db.Decimal(5, 2)
  gracePeriodDays           Int      @default(0) @map("grace_period_days")
  
  // Modo de Cobrança: 1=Desativado, 2=Supervisionado, 3=Autônomo
  collectionMode            Int      @default(2) @map("collection_mode") @db.SmallInt
  
  // Gateway de Pagamento
  paymentGateway            String?  @default("asaas") @map("payment_gateway") @db.VarChar(50)
  paymentGatewayApiKey      String?  @map("payment_gateway_api_key")
  
  // WhatsApp
  whatsappPhoneNumberId     String?  @map("whatsapp_phone_number_id") @db.VarChar(100)
  whatsappBusinessAccountId String?  @map("whatsapp_business_account_id") @db.VarChar(100)
  whatsappApiToken          String?  @map("whatsapp_api_token")
  
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  // Relações
  organization              Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_settings")
}

// ============================================
// PERMISSÕES (tabela estática global)
// ============================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)   // ex: 'properties.create'
  groupName   String   @map("group_name") @db.VarChar(50)  // ex: 'properties'
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relações
  rolePermissions RolePermission[]

  @@map("permissions")
}

// ============================================
// ROLES (papéis - dinâmicos por organização)
// ============================================

model Role {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(255)
  isSystem        Boolean  @default(false) @map("is_system") // true = não pode deletar
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relações
  organization    Organization     @relation(fields: [organizationId], references: [id])
  users           User[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

// ============================================
// ROLE_PERMISSIONS (N:N entre roles e permissions)
// ============================================

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // Relações
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// USUÁRIOS
// ============================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  name            String    @db.VarChar(255)
  email           String    @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  loginAttempts   Int       @default(0) @map("login_attempts")
  lockedUntil     DateTime? @map("locked_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relações
  organization        Organization        @relation(fields: [organizationId], references: [id])
  role                Role                @relation(fields: [roleId], references: [id])
  refreshTokens       RefreshToken[]
  contractAdjustments ContractAdjustment[]
  approvedMessages    CollectionMessage[] @relation("ApprovedBy")
  registeredPayments  Payment[]           @relation("RegisteredBy")
  auditLogs           AuditLog[]

  @@unique([organizationId, email])
  @@map("users")
}

// ============================================
// REFRESH TOKENS
// ============================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============================================
// PROPRIETÁRIOS
// ============================================

model Owner {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String   @db.VarChar(255)
  cpfCnpj         String   @map("cpf_cnpj") @db.VarChar(18)
  email           String?  @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  addressStreet   String?  @map("address_street") @db.VarChar(255)
  addressCity     String?  @map("address_city") @db.VarChar(100)
  addressState    String?  @map("address_state") @db.Char(2)
  addressZip      String?  @map("address_zip") @db.VarChar(10)
  bankName        String?  @map("bank_name") @db.VarChar(100)
  bankAgency      String?  @map("bank_agency") @db.VarChar(20)
  bankAccount     String?  @map("bank_account") @db.VarChar(30)
  bankPixKey      String?  @map("bank_pix_key") @db.VarChar(255)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relações
  organization Organization @relation(fields: [organizationId], references: [id])
  properties   Property[]
  contracts    Contract[]

  @@unique([organizationId, cpfCnpj])
  @@map("owners")
}

// ============================================
// IMÓVEIS
// ============================================

model Property {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  ownerId             String   @map("owner_id") @db.Uuid
  type                String   @db.VarChar(50)  // casa, apartamento, sala_comercial
  addressStreet       String   @map("address_street") @db.VarChar(255)
  addressNumber       String?  @map("address_number") @db.VarChar(20)
  addressComplement   String?  @map("address_complement") @db.VarChar(100)
  addressNeighborhood String?  @map("address_neighborhood") @db.VarChar(100)
  addressCity         String   @map("address_city") @db.VarChar(100)
  addressState        String   @map("address_state") @db.Char(2)
  addressZip          String?  @map("address_zip") @db.VarChar(10)
  areaSqm             Decimal? @map("area_sqm") @db.Decimal(10, 2)
  bedrooms            Int?     @db.SmallInt
  bathrooms           Int?     @db.SmallInt
  description         String?
  status              String   @default("available") @db.VarChar(30) // available, rented, maintenance, inactive
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relações
  organization Organization @relation(fields: [organizationId], references: [id])
  owner        Owner        @relation(fields: [ownerId], references: [id])
  contracts    Contract[]

  @@map("properties")
}

// ============================================
// INQUILINOS
// ============================================

model Tenant {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String   @db.VarChar(255)
  cpf             String   @db.VarChar(14)
  email           String?  @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  whatsapp        String   @db.VarChar(20) // obrigatório para cobranças
  previousAddress String?  @map("previous_address") @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relações
  organization       Organization        @relation(fields: [organizationId], references: [id])
  contracts          Contract[]
  billings           Billing[]
  collectionMessages CollectionMessage[]

  @@unique([organizationId, cpf])
  @@map("tenants")
}

// ============================================
// CONTRATOS DE ALUGUEL
// ============================================

model Contract {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  rentAmount      Decimal  @map("rent_amount") @db.Decimal(12, 2)
  dueDay          Int      @map("due_day") @db.SmallInt // 1-31
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  status          String   @default("active") @db.VarChar(30) // active, terminated, cancelled
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relações
  organization Organization         @relation(fields: [organizationId], references: [id])
  property     Property             @relation(fields: [propertyId], references: [id])
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  owner        Owner                @relation(fields: [ownerId], references: [id])
  adjustments  ContractAdjustment[]
  billings     Billing[]

  @@map("contracts")
}

// ============================================
// REAJUSTES DE CONTRATO
// ============================================

model ContractAdjustment {
  id             String   @id @default(uuid()) @db.Uuid
  contractId     String   @map("contract_id") @db.Uuid
  previousAmount Decimal  @map("previous_amount") @db.Decimal(12, 2)
  newAmount      Decimal  @map("new_amount") @db.Decimal(12, 2)
  adjustmentDate DateTime @map("adjustment_date") @db.Date
  reason         String?  @db.VarChar(255)
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  // Relações
  contract Contract @relation(fields: [contractId], references: [id])
  user     User     @relation(fields: [createdBy], references: [id])

  @@map("contract_adjustments")
}

// ============================================
// COBRANÇAS (geradas automaticamente por mês)
// ============================================

model Billing {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  contractId      String    @map("contract_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  referenceMonth  DateTime  @map("reference_month") @db.Date  // YYYY-MM-01
  amount          Decimal   @db.Decimal(12, 2) // valor original
  penaltyAmount   Decimal   @default(0) @map("penalty_amount") @db.Decimal(12, 2)
  interestAmount  Decimal   @default(0) @map("interest_amount") @db.Decimal(12, 2)
  totalAmount     Decimal   @map("total_amount") @db.Decimal(12, 2) // total com encargos
  dueDate         DateTime  @map("due_date") @db.Date
  status          String    @default("pending") @db.VarChar(30)
  // pending, overdue, paid, partially_paid, cancelled

  // Dados do gateway
  gatewayChargeId   String? @map("gateway_charge_id") @db.VarChar(255)
  gatewayPixQrcode  String? @map("gateway_pix_qrcode")
  gatewayBoletoUrl  String? @map("gateway_boleto_url") @db.VarChar(500)
  gatewayPaymentUrl String? @map("gateway_payment_url") @db.VarChar(500)

  paidAt       DateTime? @map("paid_at")
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relações
  organization       Organization        @relation(fields: [organizationId], references: [id])
  contract           Contract            @relation(fields: [contractId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  payments           Payment[]
  collectionMessages CollectionMessage[]

  @@unique([contractId, referenceMonth])
  @@map("billings")
}

// ============================================
// PAGAMENTOS RECEBIDOS
// ============================================

model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  billingId        String   @map("billing_id") @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  paymentMethod    String   @map("payment_method") @db.VarChar(30) // pix, boleto, credit_card, manual
  paymentDate      DateTime @map("payment_date")
  gatewayPaymentId String?  @map("gateway_payment_id") @db.VarChar(255)
  registeredBy     String?  @map("registered_by") @db.Uuid // quem registrou (se manual)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  // Relações
  organization Organization @relation(fields: [organizationId], references: [id])
  billing      Billing      @relation(fields: [billingId], references: [id])
  user         User?        @relation("RegisteredBy", fields: [registeredBy], references: [id])

  @@map("payments")
}

// ============================================
// TEMPLATES DE MENSAGENS DE COBRANÇA
// ============================================

model CollectionTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String   @db.VarChar(100)
  category        String   @db.VarChar(50) // reminder, collection, warning, final_notice
  daysOverdueMin  Int?     @map("days_overdue_min") @db.SmallInt
  daysOverdueMax  Int?     @map("days_overdue_max") @db.SmallInt
  messageBody     String   @map("message_body") // texto com {{placeholders}}
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relações
  organization       Organization        @relation(fields: [organizationId], references: [id])
  collectionMessages CollectionMessage[]

  @@map("collection_templates")
}

// ============================================
// MENSAGENS DE COBRANÇA ENVIADAS/PENDENTES
// ============================================

model CollectionMessage {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  billingId       String    @map("billing_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  templateId      String?   @map("template_id") @db.Uuid
  channel         String    @default("whatsapp") @db.VarChar(20)
  messageBody     String    @map("message_body")
  status          String    @default("pending") @db.VarChar(30)
  // pending_approval, pending, sent, delivered, read, failed

  approvedBy          String?   @map("approved_by") @db.Uuid
  approvedAt          DateTime? @map("approved_at")
  sentAt              DateTime? @map("sent_at")
  deliveredAt         DateTime? @map("delivered_at")
  readAt              DateTime? @map("read_at")
  errorMessage        String?   @map("error_message")
  whatsappMessageId   String?   @map("whatsapp_message_id") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relações
  organization Organization        @relation(fields: [organizationId], references: [id])
  billing      Billing              @relation(fields: [billingId], references: [id])
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  template     CollectionTemplate?  @relation(fields: [templateId], references: [id])
  approver     User?                @relation("ApprovedBy", fields: [approvedBy], references: [id])

  @@map("collection_messages")
}

// ============================================
// LOGS DE AUDITORIA (imutáveis)
// ============================================

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String?  @map("organization_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  action          String   @db.VarChar(50) // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entityType      String   @map("entity_type") @db.VarChar(50) // organization, user, property, etc.
  entityId        String?  @map("entity_id") @db.Uuid
  oldData         Json?    @map("old_data")
  newData         Json?    @map("new_data")
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relações
  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  // NÃO tem updatedAt — logs são IMUTÁVEIS

  @@map("audit_logs")
}

